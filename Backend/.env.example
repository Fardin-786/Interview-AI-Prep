# Environment Mode ('development' or 'production')
NODE_ENV=production

# Server Port
PORT=8000

# Allowed Frontend URL for CORS (comma-separated for multiple origins)
FRONTEND_URL=https://your-frontend-app.vercel.app

# MongoDB Database Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/<database_name>

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# Google Gemini API Keys
GOOGLE_GENAI_API_KEY=your_primary_gemini_api_key_here
GOOGLE_GENAI_API_KEY_BACKUP=your_backup_gemini_api_key_here

# SMTP / Nodemailer Email Service Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
